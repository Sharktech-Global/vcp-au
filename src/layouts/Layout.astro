---
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShare from '../assets/home/hero/dashboard.webp';
// Global styles first, so component and page styles come later in the cascade
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	/** Comma-separated meta keywords */
	keywords?: string;
	/** Keep the page out of search results (e.g. client-only pages) */
	noindex?: boolean;
	/** Open Graph type, e.g. 'article' for blog posts */
	ogType?: string;
	/** Preload the site font; off for pages that set their own (e.g. home-v2) */
	preloadSans?: boolean;
	/** Share image for social and search previews; defaults to the platform dashboard */
	image?: ImageMetadata;
	/** Page-specific JSON-LD structured data (one object or several) */
	schema?: Record<string, unknown> | Record<string, unknown>[];
	/** ISO publish date, for articles */
	publishedTime?: string;
}

const {
	title = 'VCPility',
	description = '',
	keywords = '',
	noindex = false,
	ogType = 'website',
	image = defaultShare,
	schema,
	publishedTime,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Social share image: 1200 x 630 JPEG, the size Facebook, LinkedIn and X expect
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareUrl = Astro.site ? new URL(share.src, Astro.site).href : share.src;

// Site-wide structured data: who VCPility is and who stands behind it
const site = Astro.site?.href ?? 'https://www.vcpility.com.au/';
const organisation = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': `${site}#organization`,
	name: 'VCPility',
	url: site,
	logo: new URL('/favicon.svg', site).href,
	description:
		'VCPility is an Australian AI automation and CRM platform for small and medium businesses, built and supported by Sharktech Global.',
	email: 'growth@vcpility.com.au',
	telephone: '+61468487373',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Level 1, 244 Macquarie St',
		addressLocality: 'Liverpool',
		addressRegion: 'NSW',
		postalCode: '2170',
		addressCountry: 'AU',
	},
	areaServed: { '@type': 'Country', name: 'Australia' },
	parentOrganization: { '@type': 'Organization', name: 'Sharktech Global', url: 'https://sharktech.com.au' },
	sameAs: ['https://www.facebook.com/Sharktechvcpility', 'https://www.instagram.com/sharktechvcpility/'],
};
const website = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${site}#website`,
	name: 'VCPility',
	url: site,
	inLanguage: 'en-AU',
	publisher: { '@id': `${site}#organization` },
};
const structuredData = [organisation, website, ...(schema ? [schema].flat() : [])];
---

<!doctype html>
<html lang="en-AU">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="wOB99ImHQqAjQiSWpDiCIWaTWmz-HjBpRWdaaOjjUg8" />
		{description && <meta name="description" content={description} />}
		{keywords && <meta name="keywords" content={keywords} />}
		{noindex && <meta name="robots" content="noindex" />}
		<title>{title}</title>
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="VCPility" />
		<meta property="og:locale" content="en_AU" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={shareUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={shareUrl} />
		{!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
		<Font cssVariable="--font-sans" preload />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<!-- Reading progress, in the logo colours (CSS scroll-driven; hidden where unsupported) -->
		<div class="progress" aria-hidden="true"></div>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />

		<script>
			import { initEffects } from '../scripts/effects';

			const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

			/* Count-up for [data-count] numbers. The final value is already rendered, so
			   nothing is lost without JS. Options: data-decimals, data-prefix, data-suffix,
			   data-count-delay (ms). */
			const countUp = (el: HTMLElement) => {
				const { count = '0', decimals = '0', prefix = '', suffix = '', countDelay = '0' } = el.dataset;
				const target = Number(count);
				const places = Number(decimals);
				const start = performance.now() + Number(countDelay);
				const duration = 1600;

				const tick = (now: number) => {
					const t = Math.min(Math.max((now - start) / duration, 0), 1);
					const eased = 1 - (1 - t) ** 3;
					el.textContent = prefix + (target * eased).toFixed(places) + suffix;
					if (t < 1) requestAnimationFrame(tick);
				};
				requestAnimationFrame(tick);
			};

			/* Scroll reveal: adds .is-visible the first time an element enters view.
			   .reveal / .reveal-lines come with default styles; [data-reveal] just gets the class. */
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						const el = entry.target as HTMLElement;
						el.classList.add('is-visible');
						if (el.dataset.count && !reduceMotion) countUp(el);
						observer.unobserve(el);
					}
				},
				{ threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
			);

			document
				.querySelectorAll('.reveal, .reveal-lines, [data-reveal], [data-count]')
				.forEach((el) => observer.observe(el));

			/* Pause looping animations in [data-pause-offscreen] containers while they're out of view */
			const pauser = new IntersectionObserver((entries) => {
				for (const entry of entries) entry.target.classList.toggle('is-offscreen', !entry.isIntersecting);
			});

			document.querySelectorAll('[data-pause-offscreen]').forEach((el) => pauser.observe(el));

			initEffects();
		</script>
	</body>
</html>
